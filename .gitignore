# Database / Large files
# The EA FC (Kaggle) dumps are up to ~96 MB each — too big for git. Drop them
# into ./database and the API loads them automatically on first start; without
# them it falls back to the JSON fixtures in database/fixtures.
database/*.csv
database/temp/

# Embedded MongoDB data directory (created when no mongod is running)
.mongo-data/

# Runtime logs
server/ingest_error.log
